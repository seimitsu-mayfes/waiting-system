// schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // DATABASE_URL は .env ファイルで設定される
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id            Int      @id @default(autoincrement()) // ID は自動的にインクリメント
  displayName   String                               // LINE display name
  userId        String   @unique                     // LINE userId（ユニークな値）
  language      String                               // 言語（例：en）
  pictureUrl    String                               // プロフィール画像のURL
  statusMessage String                               // ステータスメッセージ
  createdAt     DateTime @default(now())             // 作成日
  updatedAt     DateTime @updatedAt                  // 更新日
}